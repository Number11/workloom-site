---
interface Props { stats: { num: string; label: string }[]; cols?: number }
const { stats, cols = 4 } = Astro.props;
const colsClass = cols === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4';
---
<div class={`grid grid-cols-2 ${colsClass} gap-6`}>
  {stats.map((p) => (
    <div>
      <p class="num text-ink">{p.num}</p>
      <p class="mt-2 text-[15px] text-ink-soft">{p.label}</p>
    </div>
  ))}
</div>
