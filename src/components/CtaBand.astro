---
import { cta } from '../data/site';
interface Props { title: string; body: string; label?: string; href?: string; secondary?: { label: string; href: string } }
const { title, body, label = cta.label, href = cta.href, secondary } = Astro.props;
---
<section class="section bg-ink text-white">
  <div class="container-site max-w-3xl">
    <h2 class="h2">{title}</h2>
    <p class="mt-5 text-lg text-mist max-w-[60ch]">{body}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={href} class="btn-primary">{label}</a>
      {secondary && <a href={secondary.href} class="btn-secondary-dark">{secondary.label}</a>}
    </div>
  </div>
</section>
