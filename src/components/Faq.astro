---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="grid gap-3 max-w-3xl">
  {items.map((f) => (
    <details class="card group">
      <summary class="list-none cursor-pointer flex items-start justify-between gap-4 font-semibold">
        <span>{f.q}</span>
        <span class="text-copper-ink shrink-0 group-open:rotate-45 transition-transform text-xl leading-none" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-[15px] text-ink-soft">{f.a}</p>
    </details>
  ))}
</div>
