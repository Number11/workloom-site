---
interface Props { steps: { n: string; title: string; meta?: string; body: string }[] }
const { steps } = Astro.props;
---
<ol class="grid gap-5 md:grid-cols-3">
  {steps.map((s) => (
    <li class="card">
      <p class="font-mono text-copper-ink text-sm font-semibold">{s.n}</p>
      <h3 class="h3 mt-2">{s.title}</h3>
      {s.meta && <p class="mt-1 font-mono text-[15px] text-ink-soft">{s.meta}</p>}
      <p class="mt-3 text-[15px] text-ink-soft">{s.body}</p>
    </li>
  ))}
</ol>
