---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page isn't here." noindex>
  <section class="section">
    <div class="container-site max-w-2xl">
      <p class="eyebrow font-mono">404</p>
      <h1 class="h2 mt-3">That page isn't here.</h1>
      <p class="lede mt-4">It may have moved, or it hasn't been built yet.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-secondary">Home</a>
        <a href="/contact" class="btn-primary">Book an audit</a>
      </div>
    </div>
  </section>
</Base>
