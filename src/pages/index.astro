---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ReportCard from '../components/ReportCard.astro';
import ToolsStrip from '../components/ToolsStrip.astro';
import AudienceTiles from '../components/AudienceTiles.astro';
import DeliverableCard from '../components/DeliverableCard.astro';
import ZapMap from '../components/ZapMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const cases = [
  { num: '16 → 1', title: 'Sixteen Zaps replaced by one mapping table', body: 'Shopify brand. New product went from an hour of Zap edits to one spreadsheet row.', tag: 'Integrations' },
  { num: '$5,460', title: 'The weekly spend where ROAS breaks', body: 'HandleLetteredDesign.com. Budget went from gut feel to a number reviewed every Monday.', tag: 'Profitability reporting' },
  { num: '117', title: 'Email sequences audited, five-phase cleanup', body: 'Kit account with years of tag sprawl. Plus a 145K-subscriber migration plan with cost scenarios.', tag: 'Email systems' },
];
---
<Base
  title="WorkLoom — Lead-to-contract systems, profitability reporting, and automation for owner-operated businesses"
  description="Built for contractors, law firms, and Shopify stores by one person who shows you the spreadsheet. Start with a solution, or a $2,500 audit if you don't know where to start."
>
  <!-- HERO -->
  <section class="section bg-ink text-white">
    <div class="container-site grid gap-14 lg:grid-cols-2 items-center">
      <div class="flex flex-col gap-6">
        <p class="eyebrow !text-copper-bright">Systems that make money for owner-operated businesses</p>
        <h1 class="display max-w-[18ch]">If your tools don't talk to each other, who's doing the work in between?</h1>
        <p class="text-lg md:text-xl text-mist max-w-[52ch]">Lead-to-contract systems, profitability reporting, and the automations between your tools — built for contractors, law firms, and Shopify stores by one person who shows you the spreadsheet.</p>
        <div class="flex flex-wrap gap-3">
          <a href="#solutions" class="btn-primary">Find your solution</a>
          <a href="/audit" class="btn-secondary-dark">Start with a {site.auditPrice} audit</a>
        </div>
      </div>
      <div class="flex justify-center lg:justify-end"><ReportCard /></div>
    </div>
  </section>

  <ToolsStrip />

  <!-- AUDIENCES -->
  <Section id="solutions" eyebrow="Who it's for" title="Four kinds of business. A built solution for each." lede="Pick yours. Each page shows the system I install and what it replaces.">
    <AudienceTiles />
  </Section>

  <!-- AUDIT -->
  <Section id="audit" tone="warm">
    <div class="grid gap-12 lg:grid-cols-2 items-start">
      <div class="flex flex-col gap-5">
        <p class="eyebrow">Don't know where to start? Start here.</p>
        <h2 class="h2">The Business Audit. Two weeks. Every fix priced.</h2>
        <p class="text-lg text-ink-soft">If you already know which system you need, skip this and book the call. If you don't, I go through every tool you pay for, every handoff between them, and the numbers that come out the other end. You get a written plan ranked by dollar impact. If nothing's worth building, the plan says so.</p>
        <div class="flex gap-8 flex-wrap pt-2">
          <div><span class="num block">{site.auditPrice}</span><span class="text-sm text-ink-soft">fixed fee</span></div>
          <div><span class="num block">1–2 wks</span><span class="text-sm text-ink-soft">start to plan</span></div>
          <div><span class="num block">0</span><span class="text-sm text-ink-soft">hourly meters</span></div>
        </div>
        <a href="/audit" class="btn-primary self-start">About the audit</a>
      </div>
      <DeliverableCard />
    </div>
  </Section>

  <!-- SYSTEMS MAP -->
  <Section eyebrow="What the work looks like" title="Your tools work. Your system doesn't." lede="Each app does its job. Nobody owns the part in between. I map that part, then replace it with one path a single person can maintain.">
    <ZapMap />
  </Section>

  <!-- PROOF -->
  <Section id="proof" tone="warm" eyebrow="Proof" title="The numbers, not the adjectives.">
    <div class="grid gap-5 md:grid-cols-3">
      {cases.map((c) => (
        <article class="card flex flex-col gap-3.5">
          <span class="font-mono text-[40px] font-semibold leading-none">{c.num}</span>
          <span class="text-lg font-semibold leading-snug">{c.title}</span>
          <span class="text-[15px] text-ink-soft">{c.body}</span>
          <span class="mt-auto pt-3 border-t border-line text-sm text-ink-soft">{c.tag}</span>
        </article>
      ))}
    </div>
    <div class="card mt-5 flex gap-6 items-center flex-wrap">
      <div class="size-16 rounded-full bg-line grid place-items-center text-xs text-ink-soft shrink-0">photo</div>
      <div class="flex-1 min-w-[280px]">
        <p class="text-lg leading-relaxed">“[One line from Lisa about what changed after the reporting and automation work.]”</p>
        <p class="mt-1.5 text-sm text-ink-soft"><strong class="text-ink">Lisa</strong> · Founder, HandleLetteredDesign.com</p>
      </div>
    </div>
  </Section>

  <!-- ABOUT -->
  <Section id="about">
    <div class="grid gap-12 lg:grid-cols-[320px_1fr] items-center">
      <div class="w-[280px] h-[340px] rounded-[14px] bg-paper-warm border border-line grid place-items-center text-sm text-ink-soft mx-auto">[Real photo of Andy]</div>
      <div class="flex flex-col gap-4">
        <p class="eyebrow">Who's doing the work</p>
        <h2 class="h2">{site.owner}, Phoenix.</h2>
        <p class="text-lg text-ink-soft">I've run marketing and operations for a Shopify brand since 2016 — reporting, email, ads data, automations, subscription launch, the whole stack — and I underwrite commercial real estate on the side. WorkLoom is that same work, offered to other owner-operators.</p>
        <p class="text-lg font-semibold">Not an agency. No account managers. The person you talk to is the person building it.</p>
      </div>
    </div>
  </Section>

  <CtaBand title="Tell me what's not working." body="Thirty minutes about your business and your tools. I'll tell you which system fits, or that you should start with the audit, or that there's nothing worth building yet." secondary={{ label: `Start with a ${site.auditPrice} audit`, href: '/audit' }} />
</Base>
