---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const services = [
  {
    n: '01',
    title: 'Revenue Reporting & Analytics',
    promise: 'Weekly reporting that changes decisions, not a dashboard nobody opens.',
    body: 'ROAS by spend level. Contribution margin by SKU. Subscription cohorts. One "decision of the week" at the top of every report.',
    who: 'Shopify brands spending $10K+/month on ads without a clear read on which dollars are working.',
  },
  {
    n: '02',
    title: 'Email & Lifecycle Systems',
    promise: 'Your list is your most underused asset. Turn it into a system.',
    body: 'Account audit, then the flows that make money while you sleep: welcome, post-purchase, win-back, subscription onboarding, gift handling. Migration planning if your platform is the bottleneck.',
    who: 'Brands with 50K+ subscribers and fewer than five automations actually running.',
  },
  {
    n: '03',
    title: 'Automation & Integration',
    promise: 'Replace Zap sprawl with a system one person can maintain.',
    body: 'Audit what you have, find the failure points, rebuild onto mapping tables and workflows with error handling. n8n, Shopify Flow, Airtable, Google Sheets, fulfillment sync.',
    who: 'Operators who are afraid to open their Zapier account.',
  },
];

const cases = [
  {
    num: '16 Zaps → 1 mapping table',
    body: 'A Shopify brand had sixteen separate Zaps assigning email tags, sequences, and course access every time a product sold. Any new SKU meant editing all sixteen. Rebuilt as one Google Sheet keyed by SKU driving a single looping workflow.',
    before: '16 Zaps, about an hour per new product, frequent silent failures.',
    after: '1 workflow. A new product is one row. One place to look when something\'s wrong.',
  },
  {
    num: 'Found the spend level where ROAS breaks',
    body: 'Weekly ROAS-by-spend analysis for HandleLetteredDesign.com showed returns dropping off above roughly $5,460/week in ad spend and recovering at lower daily budgets. The report produced a budget ceiling, not a chart.',
    before: 'Budget set by feel.',
    after: 'A number to spend to, reviewed weekly.',
  },
  {
    num: '117 sequences audited, 5-phase cleanup',
    body: 'A Kit account with 117 sequences and years of accumulated tags. Full audit, then a five-phase cleanup checklist the team could work through without breaking anything live. Separately, a Kit-to-Klaviyo evaluation across ~145K active subscribers produced a 6–8 week migration plan with cost scenarios.',
    before: 'Nobody knew what was still running.',
    after: 'A list, a plan, and a decision on the platform.',
  },
];
---
<Base
  title="WorkLoom — Revenue Operations & Automation for Owner-Operated Businesses"
  description="Weekly reporting that drives decisions, email systems that make money, and automations one person can maintain. Audit first, build second. Phoenix-based, works remote."
>
  <!-- HERO -->
  <section class="section bg-paper">
    <div class="container-site">
      <p class="eyebrow">Revenue operations and automation for owner-operated businesses</p>
      <h1 class="display mt-4 max-w-[18ch]">You're paying for four part-time jobs. You need one system.</h1>
      <p class="lede mt-6">Reporting, email, ads data, and the automations that connect them — built from the tools you already own, run by one person who shows you the spreadsheet.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Start with an audit</a>
        <a href="#proof" class="btn-secondary">See the case studies</a>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section class="border-y border-line bg-paper-warm">
    <div class="container-site py-8 grid grid-cols-2 md:grid-cols-4 gap-6">
      {site.proof.map((p) => (
        <div>
          <p class="num text-ink">{p.num}</p>
          <p class="mt-2 text-[15px] text-ink-soft">{p.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section">
    <div class="container-site grid gap-10 md:grid-cols-2 md:gap-16 items-start">
      <h2 class="h2">Your tools work. Your system doesn't.</h2>
      <div class="prose-site text-ink-soft">
        <p>Shopify, Kit or Klaviyo, Meta, Google, Zapier, a fulfillment app, and six spreadsheets. Each one does its job. Nobody owns the part in between.</p>
        <p>So the weekly report takes half a day and still doesn't say what to change. Email runs on three flows built two years ago. Nobody touches Zapier because nobody knows what will break. And the ad budget goes up or down on a gut feeling.</p>
        <p class="text-ink font-medium">That's not a tools problem. It's an operations problem, and it's fixable in weeks, not quarters.</p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section bg-paper-warm scroll-mt-20">
    <div class="container-site">
      <p class="eyebrow">What WorkLoom does</p>
      <h2 class="h2 mt-3">Three service lines. One operating system.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {services.map((s) => (
          <article class="card flex flex-col">
            <p class="font-mono text-copper text-sm font-semibold">{s.n}</p>
            <h3 class="h3 mt-2">{s.title}</h3>
            <p class="mt-3 font-medium">{s.promise}</p>
            <p class="mt-3 text-[15px] text-ink-soft">{s.body}</p>
            <p class="mt-auto pt-5 text-[15px] text-ink-soft"><span class="font-semibold text-ink">For:</span> {s.who}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container-site">
      <p class="eyebrow">How it works</p>
      <h2 class="h2 mt-3">Audit first. Always.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        <li class="card">
          <p class="font-mono text-copper text-sm font-semibold">Step 1</p>
          <h3 class="h3 mt-2">Audit</h3>
          <p class="mt-1 font-mono text-[15px] text-ink-soft">{site.auditPrice} · {site.auditDuration} · fixed fee</p>
          <p class="mt-3 text-[15px] text-ink-soft">I go through your stack, your data, and your numbers. You get a prioritized plan with the expected impact of each item, in dollars where the data supports it. If nothing's worth building, the plan says so.</p>
        </li>
        <li class="card">
          <p class="font-mono text-copper text-sm font-semibold">Step 2</p>
          <h3 class="h3 mt-2">Build</h3>
          <p class="mt-1 font-mono text-[15px] text-ink-soft">fixed scope · quoted from the audit</p>
          <p class="mt-3 text-[15px] text-ink-soft">No hourly meters, no open-ended retainers to get something built.</p>
        </li>
        <li class="card">
          <p class="font-mono text-copper text-sm font-semibold">Step 3</p>
          <h3 class="h3 mt-2">Operate</h3>
          <p class="mt-1 font-mono text-[15px] text-ink-soft">optional · monthly</p>
          <p class="mt-3 text-[15px] text-ink-soft">Reporting, email ops, and automation maintenance on a monthly retainer. One system, one person, one invoice instead of four.</p>
        </li>
      </ol>
      <p class="mt-6 text-[15px] text-ink-soft">I don't quote a build without an audit. The audit is how we both know the build is worth it.</p>
    </div>
  </section>

  <!-- PROOF -->
  <section id="proof" class="section bg-paper-warm scroll-mt-20">
    <div class="container-site">
      <p class="eyebrow">Proof</p>
      <h2 class="h2 mt-3">The numbers, not the adjectives.</h2>
      <div class="mt-10 grid gap-5">
        {cases.map((c) => (
          <article class="card grid gap-5 md:grid-cols-[1.2fr_1fr] md:gap-10">
            <div>
              <h3 class="h3 font-mono">{c.num}</h3>
              <p class="mt-3 text-[15px] text-ink-soft">{c.body}</p>
            </div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-[15px] self-center">
              <dt class="font-semibold text-ink-soft">Before</dt><dd>{c.before}</dd>
              <dt class="font-semibold text-teal">After</dt><dd>{c.after}</dd>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section">
    <div class="container-site grid gap-8 md:grid-cols-2 md:gap-16 items-start">
      <div>
        <p class="eyebrow">Products</p>
        <h2 class="h2 mt-3">I ship things, not just plans.</h2>
      </div>
      <div class="card">
        <h3 class="h3">LotCheck</h3>
        <p class="mt-3 text-[15px] text-ink-soft">A white-label lot evaluator for casita and ADU builders. Embeds on your site, qualifies the lead, sends it to your CRM by webhook. <span class="font-mono text-ink">$149/mo</span>, 14-day free trial, Phoenix-area to start.</p>
        <a href="https://casita-site.andypfunk.workers.dev/lot-check/" class="link mt-4 inline-block" rel="noopener">Try the live demo →</a>
      </div>
    </div>
  </section>

  <!-- REAL ESTATE HAND-OFF -->
  <section class="section bg-paper-warm">
    <div class="container-site grid gap-8 md:grid-cols-2 md:gap-16 items-start">
      <h2 class="h2">Also: deal and investor systems for small developers.</h2>
      <div class="prose-site text-ink-soft">
        <p>Underwriting and feasibility models, construction loan schedules, entitlement critical paths, and the investor CRM and email infrastructure to go with them. Separate buyer, separate page.</p>
        <p class="text-[15px]">Real estate page coming soon. Until then, <a href="/contact" class="link">use the contact form</a> and mention the deal.</p>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section scroll-mt-20">
    <div class="container-site grid gap-8 md:grid-cols-2 md:gap-16 items-start">
      <div>
        <p class="eyebrow">Who's doing the work</p>
        <h2 class="h2 mt-3">{site.owner}, {site.city.replace(', AZ', '')}.</h2>
      </div>
      <div class="prose-site text-ink-soft">
        <p>I've run marketing and operations for a Shopify brand since 2016 — reporting, email, ads data, automations, subscription launch, the whole stack — and I underwrite commercial real estate on the side. WorkLoom is that same work, offered to other owner-operators.</p>
        <p class="text-ink font-medium">Not an agency. No account managers. The person you talk to is the person building it.</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section bg-ink text-white">
    <div class="container-site max-w-3xl">
      <h2 class="h2">Start with the audit.</h2>
      <p class="mt-5 text-lg text-mist max-w-[60ch]">Fixed fee, {site.auditDuration}, and you end up with a prioritized plan whether or not we work together after. Tell me about your stack and what's not working.</p>
      <a href="/contact" class="btn-primary mt-8">Book an audit</a>
    </div>
  </section>
</Base>
